function generateTenThousandResponses() {
    let pool = [...baseTopics, ...baseReplies];
    const modifiers = ["يا عيال", "يا أساطير", "بالضبط", "صراحة", "بدون زعل", "والله", "يا وحوش", "يا جماعة", "تخيل", "ياشيخ"];
